root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
max_line_length = 160

[*.{c,cpp,h}]
indent_size = 4

[scripts/vcam/*.c]
indent_style = tab

[*.{yml,yaml,json,toml,md}]
indent_size = 2

[*.patch]
trim_trailing_whitespace = false

[*.bat]
end_of_line = crlf
